pipeline {
    agent any

    tools {
        nodejs 'NodeJS-18'
    }

    environment {
        DOCKERHUB_USER = 'ilyeschrif21'
        IMAGE_BACKEND  = "${DOCKERHUB_USER}/mern-backend"
        IMAGE_FRONTEND = "${DOCKERHUB_USER}/mern-frontend"
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Ilyeschrif22/jenkins-sonarqube-pipeline-starter.git'
            }
        }

        // ── CI BACKEND ──────────────────────────────
        stage('CI Backend') {
            stages {
                stage('Install Backend') {
                    steps {
                        dir('backend') { sh 'npm install' }
                    }
                }

                stage('Lint Backend') {
                    steps {
                        dir('backend') {
                            sh 'npm run lint || true'
                        }
                    }
                }

                stage('Test Backend') {
                    steps {
                        dir('backend') {
                            sh 'npm run test -- --coverage --watchAll=false'
                        }
                    }
                    post {
                        always {
                            publishHTML(target: [
                                reportDir: 'backend/coverage/lcov-report',
                                reportFiles: 'index.html',
                                reportName: 'Backend Coverage Report'
                            ])
                        }
                    }
                }
            }
        }

        // ── CI FRONTEND ─────────────────────────────
        stage('CI Frontend') {
            stages {
                stage('Install Frontend + Backoffice') {
                    parallel {
                        stage('Frontend deps') {
                            steps {
                                dir('frontend') {
                                    sh 'npm install --legacy-peer-deps'
                                }
                            }
                        }
                        stage('Backoffice deps') {
                            steps {
                                dir('backofficee') {
                                    sh 'npm install --legacy-peer-deps'
                                }
                            }
                        }
                    }
                }

                stage('Test Frontend') {
                    steps {
                        dir('frontend') {
                            sh 'npm run test -- --coverage --watchAll=false'
                        }
                    }
                }

                stage('Test Backoffice') {
                    steps {
                        dir('backofficee') {
                            sh 'npm run test -- --coverage --watchAll=false || true'
                        }
                    }
                }

                stage('Build Frontend') {
                    steps {
                        dir('frontend') { sh 'npm run build' }
                    }
                }
            }
        }

        // ── SONARQUBE ────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh "${tool 'sonarqube'}/bin/sonar-scanner"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ── CD BACKEND ───────────────────────────────
        stage('CD Backend') {
            stages {
                stage('Docker Build Backend') {
                    steps {
                        sh 'docker-compose build backend'
                    }
                }

                stage('Push Backend to DockerHub') {
                    steps {
                        withCredentials([usernamePassword(
                            credentialsId: 'dockerhub',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                            sh "docker tag mern-pipeline-backend ${IMAGE_BACKEND}:${BUILD_NUMBER}"
                            sh "docker tag mern-pipeline-backend ${IMAGE_BACKEND}:latest"
                            sh "docker push ${IMAGE_BACKEND}:${BUILD_NUMBER}"
                            sh "docker push ${IMAGE_BACKEND}:latest"
                        }
                    }
                }

                stage('Deploy Backend to K8s') {
                    steps {
                        sh 'kubectl apply -f k8s/backend-deployment.yaml'
                        sh 'kubectl rollout restart deployment/backend'
                        sh 'kubectl rollout status deployment/backend --timeout=60s'
                    }
                }
            }
        }

        // ── CD FRONTEND ──────────────────────────────
        stage('CD Frontend') {
            stages {
                stage('Docker Build Frontend') {
                    steps {
                        sh 'docker-compose build frontend'
                    }
                }

                stage('Push Frontend to DockerHub') {
                    steps {
                        withCredentials([usernamePassword(
                            credentialsId: 'dockerhub',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                            sh "docker tag mern-pipeline-frontend ${IMAGE_FRONTEND}:${BUILD_NUMBER}"
                            sh "docker tag mern-pipeline-frontend ${IMAGE_FRONTEND}:latest"
                            sh "docker push ${IMAGE_FRONTEND}:${BUILD_NUMBER}"
                            sh "docker push ${IMAGE_FRONTEND}:latest"
                        }
                    }
                }

                stage('Deploy Frontend to K8s') {
                    steps {
                        sh 'kubectl apply -f k8s/frontend-deployment.yaml'
                        sh 'kubectl rollout restart deployment/frontend'
                        sh 'kubectl rollout status deployment/frontend --timeout=60s'
                    }
                }
            }
        }
    }

    post {
        always  {
            echo 'Pipeline finished.'
            cleanWs()
        }
        success { echo '✅ All stages passed. Deployment complete.' }
        failure { echo '❌ Pipeline failed — check the stage logs above.' }
    }
}