{
  "name": "smartproperty-backend",
  "version": "1.0.0",
  "description": "SmartProperty - AI-Powered Property Management Platform Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=lcov --coverageReporters=text --forceExit"
  },
  "keywords": [
    "real-estate",
    "property-management",
    "ai",
    "saas"
  ],
  "author": "SmartProperty Team",
  "license": "ISC",
  "dependencies": {
    "@huggingface/inference": "^4.13.15",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "groq-sdk": "^0.3.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.1.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.1",
    "openai": "^4.20.1",
    "pusher": "^5.3.3",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/controllers/feedbackController.js",
      "src/controllers/easyWalletController.js",
      "src/services/reviewProfanity.service.js",
      "src/middleware/auth.middleware.js",
      "src/utils/apiResponse.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["lcov", "text", "clover"],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/*.test.js",
      "**/*.spec.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
